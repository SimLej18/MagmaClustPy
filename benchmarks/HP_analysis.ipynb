    "    }\n",
    "   },\n",
    "   \"cell_type\": \"code\",\n",
    "   \"source\": [\n",
    "    \"# Build a 3D scatter plot to compare the two groups\\n\",\n",
    "    \"# NaNs are red, OKs are blue\\n\",\n",
    "    \"# x is ls_1 + ls_2\\n\",\n",
    "    \"# y is var_1 * var_2\\n\",\n",
    "    \"# z is ls_u\\n\",\n",
    "    \"\\n\",\n",
    "    \"x = db['ls_1'] + db['ls_2'] + db['ls_u']\\n\",\n",
    "    \"y = db['var_1'] * db['var_2']\\n\",\n",
    "    \"z = db['ls_u']\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Calculate coordinates for NaN group\\n\",\n",
    "    \"x_nan = x[db['has_nans'] == True]\\n\",\n",
    "    \"y_nan = y[db['has_nans'] == True]\\n\",\n",
    "    \"z_nan = z[db['has_nans'] == True]\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Calculate coordinates for OK group\\n\",\n",
    "    \"x_ok = x[db['has_nans'] == False]\\n\",\n",
    "    \"y_ok = y[db['has_nans'] == False]\\n\",\n",
    "    \"z_ok = z[db['has_nans'] == False]\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Create 3D scatter plot with Plotly\\n\",\n",
    "    \"fig = go.Figure()\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Add NaN group (red)\\n\",\n",
    "    \"fig.add_trace(go.Scatter3d(\\n\",\n",
    "    \"    x=x_nan,\\n\",\n",
    "    \"    y=y_nan,\\n\",\n",
    "    \"    z=z_nan,\\n\",\n",
    "    \"    mode='markers',\\n\",\n",
    "    \"    marker=dict(size=5, color='red', opacity=0.6),\\n\",\n",
    "    \"    name='Has NaNs'\\n\",\n",
    "    \"))\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Add OK group (blue)\\n\",\n",
    "    \"fig.add_trace(go.Scatter3d(\\n\",\n",
    "    \"    x=x_ok,\\n\",\n",
    "    \"    y=y_ok,\\n\",\n",
    "    \"    z=z_ok,\\n\",\n",
    "    \"    mode='markers',\\n\",\n",
    "    \"    marker=dict(size=5, color='blue', opacity=0.6),\\n\",\n",
    "    \"    name='No NaNs'\\n\",\n",
    "    \"))\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Update layout\\n\",\n",
    "    \"fig.update_layout(\\n\",\n",
    "    \"    title='Hyperparameter Analysis: NaN vs No NaN (3D)',\\n\",\n",
    "    \"    scene=dict(\\n\",\n",
    "    \"        xaxis_title='Inv of sum of length scales  |  1/(ls_1 + ls_2)',\\n\",\n",
    "    \"        yaxis_title='Product of variances  |  var_1 * var_2',\\n\",\n",
    "    \"        zaxis_title='1/(ls_u)'\\n\",\n",
    "    \"    ),\\n\",\n",
    "    \"    width=900,\\n\",\n",
    "    \"    height=700\\n\",\n",
    "    \")\\n\",\n",
    "    \"\\n\",\n",
